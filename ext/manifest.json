{
  "manifest_version": 3,
  "name": "Kantoro — Subtítulos japoneses en rōmaji",
  "short_name": "Kantoro",
  "version": "1.7.1",
  "description": "Convierte al instante los subtítulos y textos japoneses (kanji, hiragana, katakana) en rōmaji, con traducción y diccionario al pasar el ratón.",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage",
    "offscreen",
    "activeTab",
    "scripting",
    "contextMenus",
    "tabCapture",
    "webRequest"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.crunchyroll.com/*"
      ],
      "js": [
        "content/hook.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "engine/subparse.js",
        "content/content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kantoro",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Activar / desactivar el rōmaji"
    },
    "ocr-region": {
      "suggested_key": {
        "default": "Alt+O"
      },
      "description": "Leer subtítulos con OCR o audio (pulsar de nuevo para detener)"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup/*",
        "icons/*",
        "asr/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}