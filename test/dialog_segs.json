[{"spk": "A", "text": "おい、ちょっと待ってくれ", "start": 0.4570840821913511, "end": 3.3158340821913512}, {"spk": "B", "text": "どうしたの、そんなに急いで", "start": 3.9107372335745296, "end": 7.99129973357453}, {"spk": "A", "text": "大変なことが起きたんだ", "start": 8.507779558521165, "end": 14.855717058521165}, {"spk": "C", "text": "え、なになに、教えて", "start": 15.477481075889452, "end": 16.96635607588945}, {"spk": "B", "text": "落ち着いて話してください", "start": 17.597930212738074, "end": 23.207992712738076}, {"spk": "A", "text": "村の外に化け物が出た", "start": 23.587480699395993, "end": 30.394355699395994}, {"spk": "C", "text": "うそでしょ、こわいよ", "start": 30.750281295595688, "end": 32.142031295595686}, {"spk": "B", "text": "大丈夫、私が守るから", "start": 32.868892382539094, "end": 39.604704882539096}, {"spk": "A", "text": "早く逃げる準備をしろ", "start": 40.0714141889867, "end": 46.0154766889867}, {"spk": "C", "text": "わかった、すぐ行く", "start": 46.47092562145772, "end": 49.73498812145772}, {"spk": "B", "text": "みんな、こっちに来て", "start": 50.533028297437426, "end": 53.33034079743742}, {"spk": "A", "text": "急げ、時間がないぞ", "start": 53.89195937582252, "end": 59.01770937582252}, {"spk": "C", "text": "お兄ちゃん待って", "start": 59.74411702889599, "end": 62.436054528895994}, {"spk": "B", "text": "手をつないで走って", "start": 63.00041347281069, "end": 66.98841347281069}, {"spk": "A", "text": "よし、全員そろったな", "start": 67.62599413605557, "end": 71.16136913605557}]